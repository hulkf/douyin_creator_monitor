{
  "python": "",
  "max_works": 0,
  "state_dir": "runtime/pipeline",
  "media_dir": "runtime/media",
  "log_dir": "logs",
  "collection": {
    "incremental_enabled": true,
    "incremental_probe_count": 3,
    "cdp_port_start": 9222,
    "cdp_port_stride": 10,
    "account_profiles": [],
    "per_creator_profile_pool": true,
    "media_crawler_dir": "D:/path/to/MediaCrawler",
