  "correction": {
    "domain": "douyin_shop_ads",
    "glossary": "config/domain_glossary.json"
  },
  "summary": {
    "enabled": true,
    "model": "",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.2,
    "max_tokens": 1800,
    "timeout": 120,
    "retry_attempts": 3
  },
  "backups": {
    "max_workers": 3,
    "mapping_cache_ttl_hours": 24
  },
  "ima": {
    "enabled": true,
    "mapping": "local/ima_creator_mapping.json",
    "on_duplicate": "skip"
  },
  "kuake": {
    "enabled": true,
    "local_env": "local/kuake.env.json",
    "kuake_exe": "tools/kuake-cli/kuake.exe",
    "base_dir": ""
