    "login_type": "qrcode",
    "headless": true,
    "browser_window_width": 480,
    "browser_window_height": 360,
    "save_data_option": "jsonl",
    "profile_max_workers": 3,
    "profile_ttl_hours": 12,
    "clean_media_output": false
  },
  "feishu": {
    "base_token_env": "FEISHU_BASE_TOKEN",
    "creator_table_id": "REPLACE_WITH_FEISHU_CREATOR_TABLE_ID",
