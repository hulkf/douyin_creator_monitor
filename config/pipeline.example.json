    "expected_app_name": "REPLACE_WITH_PROJECT_FEISHU_APP_NAME",
    "work_id_field": "抖音作品ID",
    "transcript_field": "语音转写全文",
    "as_identity": "user"
  },
  "asr": {
    "provider": "volcengine",
    "mode": "direct-url",
    "max_workers": 4,
    "ffmpeg": "",
    "model": "",
    "endpoint": ""
